<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="01-add-auth-provider-to-user" author="karthik">
        <addColumn tableName="users">
            <column name="auth_provider" type="VARCHAR(20)"/>
        </addColumn>
        
        <update tableName="users">
            <column name="auth_provider" value="LOCAL"/>
        </update>

        <addNotNullConstraint tableName="users" columnName="auth_provider" columnDataType="VARCHAR(20)"/>

    </changeSet>
</databaseChangeLog>