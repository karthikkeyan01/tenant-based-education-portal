<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="06-create-audit-log-table" author="karthik">
        <createTable tableName="audit_logs" remarks="Stores application audit logs.">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" primaryKeyName="pk_audit_logs" nullable="false"/>
            </column>

            <column name="user_id" type="UUID"/>

            <column name="action" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="entity_affected" type="VARCHAR(255)"/>

            <column name="entity_id" type="VARCHAR(255)"/>

            <column name="details" type="TEXT"/>

            <column name="user_agent" type="VARCHAR(1000)">
                <constraints nullable="false"/>
            </column>

            <column name="ip_address" type="VARCHAR(255)"/>

            <column name="request_url" type="VARCHAR(255)"/>

            <column name="method" type="VARCHAR(255)"/>

            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="audit_logs" baseColumnNames="user_id" referencedTableName="users"
                                 referencedColumnNames="id" constraintName="fk_audit_logs_user"/>
    </changeSet>
</databaseChangeLog>