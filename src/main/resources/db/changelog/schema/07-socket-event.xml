<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    
    <changeSet id="07-create-socket-event-table" author="karthik">
        <createTable tableName="socket_event" remarks="Stores persistent Socket.IO events for offline users.">
            <column name="id" type="VARCHAR(36)" defaultValueComputed="gen_random_uuid()::text">
                <constraints primaryKey="true" primaryKeyName="pk_socket_event" nullable="false"/>
            </column>

            <column name="recipient_user_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>

            <column name="event_type" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>

            <column name="payload" type="JSONB">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="delivered_at" type="TIMESTAMP WITH TIME ZONE"/>

        </createTable>

        <addForeignKeyConstraint baseTableName="socket_event" baseColumnNames="recipient_user_id" constraintName="fk_socket_event_recipient_user" referencedTableName="users"
                                 referencedColumnNames="id"/>

        <createIndex indexName="idx_socket_event_recipient_delivered" tableName="socket_event">
            <column name="recipient_user_id"/>
            <column name="delivered_at"/>
        </createIndex>

    </changeSet>
</databaseChangeLog>